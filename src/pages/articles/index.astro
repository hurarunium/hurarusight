---
import Layout from '../../layouts/Layout.astro';
import { siteName } from '../../data/content.ts';
import { collectTags, getListedArticles } from '../../utils/articles.ts';
import ArticleList from '../../components/ArticleList.astro';
import TagFilter from '../../components/TagFilter.astro';

const articles = await getListedArticles();
const tags = collectTags(articles);
---
<Layout title={`Articles | ${siteName}`}>
  <main class="container page page--articles">
    <div class="articles-head">
      <h1 class="page__title">Articles</h1>
      <label class="search-box">
        <svg class="search-box__icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" />
        </svg>
        <input id="article-search" class="search-box__input" type="search" placeholder="記事を検索" aria-label="記事を検索" autocomplete="off" />
      </label>
    </div>
    <TagFilter tags={tags} />
    <ArticleList articles={articles} />
    <p id="article-search-empty" class="empty" hidden>該当する記事がありません。</p>
  </main>
</Layout>

<script>
  import { setupTagFilter } from '../../scripts/tagFilter.ts';

  // 検索語(スペース区切りの全語を含む)と選択中のタグの両方を満たす記事だけを表示する
  const input = document.getElementById('article-search') as HTMLInputElement;
  const words = () => input.value.toLowerCase().split(/\s+/).filter(Boolean);
  const filter = setupTagFilter({
    items: [...document.querySelectorAll<HTMLElement>('.article-list__item')],
    tagLinks: [...document.querySelectorAll<HTMLAnchorElement>('.article-list__tags a')],
    emptyMessage: document.getElementById('article-search-empty') as HTMLElement,
    extraMatch: (item) => {
      const search = item.dataset.search ?? '';
      return words().every((w) => search.includes(w));
    },
  });
  input.addEventListener('input', filter.refresh);
</script>
