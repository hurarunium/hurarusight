---
// 自己紹介のページ(/about/)。about.md が無い、または本番で draft のときはページを作らないため、
// 固定のページではなく、getStaticPaths で作るかどうかを決める動的ルートにしている
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { siteName, profile, links } from '../data/content.ts';
import { getAbout } from '../utils/about.ts';

export async function getStaticPaths() {
  const about = await getAbout();
  return about ? [{ params: { about: 'about' }, props: { about } }] : [];
}

const { about } = Astro.props;
const { role, photo, skills } = about.data;
const { Content } = await render(about);
const hasBody = (about.body ?? '').trim() !== '';
---
<Layout title={`About | ${siteName}`} description="hurarunium(ふらるにうむ / a.k.a huraru)の自己紹介。">
  <main class="container page page--about">
    <section class="about-head">
      {photo && <img class="about-head__photo" src={photo} alt={`${profile.name}の写真`} width="160" height="160" decoding="async" />}
      <div>
        <h1 class="about-head__name">{profile.name}</h1>
        <p class="intro__aka">a.k.a. {profile.aka.join(' / ')}</p>
        {role && <p class="about-head__role">{role}</p>}
        <p class="intro__tagline">{profile.tagline}</p>
      </div>
    </section>

    {hasBody && (
      <div class="article__body about__body">
        <Content />
      </div>
    )}

    {skills.length > 0 && (
      <section class="about-section">
        <h2 class="about-section__title">SKILLS</h2>
        <ul class="skill-grid">
          {skills.map((s) => (
            <li class="skill">
              {/* 名前を文字で出すので、アイコンは飾りとして扱う */}
              <img class="skill__icon" src={s.icon} alt="" width="36" height="36" loading="lazy" />
              <span class="skill__name">{s.name}</span>
              {s.note && <span class="skill__note">{s.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="about-section">
      <h2 class="about-section__title">LINKS</h2>
      <ul class="about-links">
        {links.map((l) => (
          <li><a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a></li>
        ))}
      </ul>
    </section>
  </main>
</Layout>
