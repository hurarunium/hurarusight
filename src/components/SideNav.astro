---
// 左のサイドナビ(ポートフォリオの横メニューを元にしている)。
// 普段はアイコンだけの細い帯で、ホバー・フォーカスで広がって名前が出る。768px 以下ではハンバーガーで開く
import { links } from '../data/content.ts';
import { getAbout } from '../utils/about.ts';

const path = Astro.url.pathname;
// About は about.md があるときだけ出す(本番では draft のときも出さない)
const hasAbout = (await getAbout()) !== undefined;

// アイコンは線だけの SVG(色は文字色に合わせる)
const icons = {
  home: '<path d="M4 11l8-7 8 7v9h-5v-6H9v6H4z"/>',
  articles: '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 12h7M9 16h7"/>',
  works: '<rect x="3" y="7" width="18" height="13" rx="1"/><path d="M8 7V4h8v3M3 12h18"/>',
  about: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>',
  github: '<path d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
  x: '<path d="M4 4l16 16M20 4L4 20"/>',
};

const menu = [
  { href: '/', label: 'Home', icon: icons.home, current: path === '/' },
  { href: '/articles/', label: 'Articles', icon: icons.articles, current: path.startsWith('/articles') },
  { href: '/works/', label: 'Works', icon: icons.works, current: path.startsWith('/works') },
  ...(hasAbout ? [{ href: '/about/', label: 'About', icon: icons.about, current: path.startsWith('/about') }] : []),
];

const external = [
  { label: 'GitHub', icon: icons.github },
  { label: 'X', icon: icons.x },
].flatMap((item) => {
  const link = links.find((l) => l.label === item.label);
  return link ? [{ ...item, url: link.url }] : [];
});
---
<aside class="side-nav" id="sideNav" aria-label="サイドナビゲーション">
  <a class="side-nav__avatar" href="/" aria-label="トップへ戻る">
    <img src="/profile-icon.png" alt="" width="40" height="40" />
  </a>

  <nav class="side-nav__menu" aria-label="メインナビゲーション">
    <ul>
      {menu.map((item) => (
        <li>
          <a href={item.href} aria-current={item.current ? 'page' : undefined}>
            <svg class="side-nav__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
            <span class="side-nav__label">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="side-nav__actions">
    {external.map((item) => (
      <a href={item.url} target="_blank" rel="noopener noreferrer">
        <svg class="side-nav__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
        <span class="side-nav__label">{item.label}</span>
      </a>
    ))}
  </div>
</aside>
