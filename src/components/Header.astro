---
import { siteName } from '../data/content.ts';

const path = Astro.url.pathname;
const isArticles = path.startsWith('/articles');
const isWorks = path.startsWith('/works');
// Articles・Works 配下ではロゴを現在地つきの表記にする(サイト名の title などは変えない)
const logoText = isArticles ? 'huraru(home.articles)' : isWorks ? 'huraru(home.works)' : siteName;
---
<header class="site-header">
  <div class="container">
    <a class="site-header__logo" href="/">{logoText}</a>
    <nav class="site-header__nav" aria-label="メインナビゲーション">
      <a class={isArticles ? 'is-current' : ''} href="/articles/">Articles</a>
      <a class={isWorks ? 'is-current' : ''} href="/works/">Works</a>
    </nav>
  </div>
</header>
