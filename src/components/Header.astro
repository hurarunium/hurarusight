---
// 上の細いバー。768px 以下でだけ出し、ハンバーガーとロゴを置く(広い画面ではロゴは本文の上)
import { getLogoText } from '../utils/logo.ts';

const logoText = getLogoText(Astro.url.pathname);
---
<header class="top-bar">
  <button type="button" class="nav-toggle" id="navToggle" aria-label="メニューを開く" aria-expanded="false" aria-controls="sideNav">
    <span class="nav-toggle__bar"></span>
    <span class="nav-toggle__bar"></span>
    <span class="nav-toggle__bar"></span>
  </button>
  <a class="top-bar__logo" href="/">{logoText}</a>
</header>
<div class="nav-overlay" id="navOverlay"></div>

<script>
  import { setupNavToggle } from '../scripts/navToggle.ts';
  setupNavToggle();
</script>
